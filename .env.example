# Optional. Path to an ERP data file with the same shape as data/erp-sample.json.
# When unset, the server uses the bundled sample data.
ERP_DATA_FILE=

# Optional. Allowed unit price difference from the PO, in percent (0-20). Default 2.
ERP_PRICE_TOLERANCE_PCT=

# Optional. Send approval requests to the approvals platform instead of keeping them in memory.
# The account needs the "agent" role. https://github.com/RomulusMirauta/approvals-platform
APPROVALS_API_URL=
APPROVALS_API_EMAIL=
APPROVALS_API_PASSWORD=
